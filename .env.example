# Local illustrative mode. The startup script selects this explicitly.
QS_MODE=demo
QS_STORAGE_DIR=.state/demo
QS_PUBLIC_ORIGIN=http://127.0.0.1:5173
# For research/production behind the gateway:
# QS_PROXY_SECRET=<random-32-byte-or-longer-value>
# QS_ALLOWED_EMAILS=researcher@example.com,colleague@example.com
# QS_PUBLIC_ORIGIN=https://research.example.com
# QS_DATA_RIGHTS_CONFIRMED=true
# FRED_API_KEY=<optional-server-side-key>

# Opt-in Supabase core (browser login integration is still pending).
# QS_BACKEND=supabase
# QS_SUPABASE_URL=https://your-project.supabase.co
# QS_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# QS_SUPABASE_MARKET_KEY=<server-only-market-key>
# QS_CSRF_SECRET=<independent-random-secret-at-least-32-characters>
# See docs/SUPABASE-DEVELOPMENT.md before enabling.
