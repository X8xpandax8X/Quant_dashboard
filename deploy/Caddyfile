{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	route {
		request_header -X-Proxy-Secret
		request_header -X-Auth-User
		request_header -X-Auth-Email
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Email
		request_header -X-Forwarded-User
		request_header -X-Forwarded-Email
		handle /oauth2/* {
			reverse_proxy oauth:4180
		}
		handle {
			forward_auth oauth:4180 {
				uri /oauth2/auth
				copy_headers X-Auth-Request-User>X-Auth-User X-Auth-Request-Email>X-Auth-Email
				@signedout status 401
				handle_response @signedout {
					@api path /api/*
					handle @api {
						respond `{"detail":"Sign in to continue"}` 401
					}
					handle {
						redir * /oauth2/sign_in 302
					}
				}
			}
			reverse_proxy app:8000 {
				header_up X-Proxy-Secret {$QS_PROXY_SECRET}
			}
		}
	}
}
